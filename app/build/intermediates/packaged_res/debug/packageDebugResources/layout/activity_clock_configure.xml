<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="時計ウィジェット設定"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- 背景色 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="背景色"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"/>
        <LinearLayout
            android:id="@+id/layout_bg_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"/>

        <!-- 透明度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="透明度"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginEnd="8dp"/>
            <SeekBar
                android:id="@+id/seekbar_alpha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255"
                android:progress="170"/>
            <TextView
                android:id="@+id/text_alpha_val"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="67%"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- 針の色 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="針・目盛りの色"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"/>
        <LinearLayout
            android:id="@+id/layout_hand_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- 盤面スタイル -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="盤面スタイル"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginBottom="8dp"/>
        <LinearLayout
            android:id="@+id/layout_face_styles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- 適用ボタン -->
        <Button
            android:id="@+id/btn_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="適用"/>

    </LinearLayout>
</ScrollView>
