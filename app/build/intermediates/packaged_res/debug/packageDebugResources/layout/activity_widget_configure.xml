<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ローディングオーバーレイ（データ取得中に表示） -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AMeDASデータを取得中..."
            android:textSize="16sp"
            android:textColor="#444444"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="初回のみ数秒かかります"
            android:textSize="12sp"
            android:textColor="#999999"/>

    </LinearLayout>

    <!-- 設定コンテンツ（データ読み込み完了後に表示） -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- タイトル -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/configure_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- 都道府県 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pref_label"
                    android:textSize="12sp"
                    android:textColor="#666666"/>
                <Button
                    android:id="@+id/btn_nearest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 現在地から選ぶ"
                    android:textSize="11sp"
                    style="?android:attr/borderlessButtonStyle"
                    android:padding="4dp"/>
            </LinearLayout>
            <Spinner
                android:id="@+id/spinner_pref"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <!-- 観測地点 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/station_label"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="4dp"/>
            <Spinner
                android:id="@+id/spinner_station"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/text_station_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#999999"
                android:layout_marginBottom="16dp"/>

            <!-- 背景色 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bg_color_label"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:id="@+id/layout_bg_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"/>

            <!-- 透明度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="透明度"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginEnd="8dp"/>
                <SeekBar
                    android:id="@+id/seekbar_alpha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="170"/>
                <TextView
                    android:id="@+id/text_alpha_val"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="67%"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- 文字色 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_color_label"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:id="@+id/layout_text_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"/>

            <!-- 文字影 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/shadow_label"
                    android:textSize="14sp"/>
                <Switch
                    android:id="@+id/switch_shadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- プレビュー -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="プレビュー"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#888888"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:id="@+id/preview_widget"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:gravity="center"
                    android:background="@drawable/widget_bg">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/preview_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☀️"
                            android:textSize="20sp"/>
                        <TextView
                            android:id="@+id/preview_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:text="23°C"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/preview_station"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="東京 14:30"
                        android:textColor="#CCFFFFFF"
                        android:textSize="9sp"
                        android:gravity="center"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </FrameLayout>

            <!-- 適用ボタン -->
            <Button
                android:id="@+id/btn_apply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apply_button"/>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
